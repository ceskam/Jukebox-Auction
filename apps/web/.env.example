NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public production origin. Set this to the canonical custom domain after it is
# connected in Vercel, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://adbidcoin.com

# Server-only. Recommended for API routes and server components that write bids,
# auctions, and winner-owned attention content.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Solana USDC payment configuration. Use matching RPC, USDC mint, and treasury
# wallet values for the same network.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_TREASURY_WALLET_ADDRESS=your-solana-treasury-wallet
TREASURY_WALLET_ADDRESS=your-solana-treasury-wallet

# QUIET Coin is used only for non-custodial bid-power snapshots. The server
# verifies the connected wallet's current token balance when recording a bid.
QUIET_MINT_ADDRESS=JCfSVdmBNKwMnMUMccfNbQQVVJKYsQNbXCqhdRuZpump

# Optional local fallback. Leave false in production.
ENABLE_DEMO_PAYMENTS=false

# Private admin review page token for /admin. Use a long random value in
# production and do not expose it publicly.
ADMIN_TOKEN=replace-with-a-long-private-admin-token

# Server-only signing key for wallet and admin sessions. Use at least 32 random
# characters and keep it separate from ADMIN_TOKEN.
WALLET_AUTH_SECRET=replace-with-a-different-long-random-secret

# Supabase Storage bucket for winner-uploaded attention images. Create it with
# database/storage.sql. The app defaults to attention-images if this is omitted.
SUPABASE_ATTENTION_IMAGE_BUCKET=attention-images

# Disclosed, operator-funded house bot. Leave disabled until database/house-bot.sql
# has been applied and a dedicated low-balance wallet is ready. The house wallet
# must be different from the treasury wallet. Never commit a real key to Git.
HOUSE_BOT_ENABLED=false
HOUSE_BOT_DELAY_MINUTES=10
HOUSE_BOT_DAILY_LIMIT_USDC=24
HOUSE_BOT_SECRET_KEY_BASE64=base64-encoded-dedicated-64-byte-keypair

# Vercel automatically sends this value as a Bearer token to cron routes.
# Use a different random value of at least 32 characters.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Review-first Growth Scout. It searches the public web and saves candidates to
# /admin; it never auto-replies, mass-messages, or posts to third-party groups.
# Keep disabled until database/growth-scout.sql has been applied.
GROWTH_SCOUT_ENABLED=false
BRAVE_SEARCH_API_KEY=your-server-only-brave-search-key
# Optional; separate up to eight queries with ||.
GROWTH_SCOUT_QUERIES="where to promote Solana project||crypto marketing Solana community||launching a token Solana"

# Optional owned-channel publishing from the admin review queue. Create the bot
# with @BotFather and add it only to a channel/group you control.
TELEGRAM_BOT_TOKEN=your-server-only-telegram-bot-token
TELEGRAM_GROWTH_CHAT_ID=@your_owned_channel_or_numeric_chat_id

# A referral must produce at least this much in its first verified user bid.
# Keep this at or above the reward amount during the beta to reduce abuse.
REFERRAL_MIN_FIRST_BID_USDC=1
